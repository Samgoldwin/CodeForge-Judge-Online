PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CodeTest
DB_USER=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
JUDGE_CONCURRENCY=2
# Development only. Production defaults to Judge0 and rejects local process execution.
JUDGE_MODE=local
# Required when JUDGE_MODE=judge0 (use IDs from your own Judge0 instance's /languages endpoint).
# JUDGE0_BASE_URL=https://judge.example.com
# JUDGE0_AUTH_TOKEN=optional_private_service_token
# JUDGE0_AUTH_USER=optional_private_service_user
# JUDGE0_LANGUAGE_JAVASCRIPT=your_node_language_id
# JUDGE0_LANGUAGE_PYTHON=your_python_language_id
# JUDGE0_LANGUAGE_CPP=your_cpp_language_id
# JUDGE0_LANGUAGE_JAVA=your_java_language_id
# JUDGE_CPU_TIME_LIMIT_SECONDS=3
# JUDGE_TIME_LIMIT_SECONDS=5
# JUDGE_MEMORY_LIMIT_KB=128000

